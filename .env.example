# =============================================================================
# JobRelay — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Or use the Notion CLI: ntn workers env set KEY=value
# =============================================================================

# REQUIRED: Anthropic API key for Claude (resume generation + scoring)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OPTIONAL: Your career profile summary (used for match scoring)
# Paste a condensed version of your resume/skills here for best results.
USER_PROFILE="Senior AI leader with 10+ years experience in..."

# OPTIONAL: Job board API keys (enables automated sync)
# Without these, use manual job entry via the scanJobs tool.
DICE_API_KEY=
INDEED_API_KEY=

# OPTIONAL: Slack webhook for notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
